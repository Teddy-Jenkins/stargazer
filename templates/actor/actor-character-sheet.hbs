          <div class="rskill-container">
            <div class="actions">
              <header class="actions-header">
                <h3>Actions</h3>
                <a class="action-create" aria-label="Add Action" title="Add Action"><i class="fas fa-plus"></i></a>
              </header>

              <div class="actions-list">
                {{#each actions as |action index|}}
                  <div class="action-entry" data-index="{{index}}">
                    <div class="action-row">
                      <input
                        type="text"
                        class="action-name"
                        value="{{action.name}}"
                        placeholder="Action Name"
                        aria-label="Action name {{index}}"
                      />
                      <a class="action-delete" aria-label="Remove Action" title="Remove Action"><i class="fas fa-trash"></i></a>
                    </div>

                    <div class="action-edges">
                      {{#each action.edges as |edge eindex|}}
                        <div
                          class="edge-pip edge-{{edge.type}} {{#if edge.dulled}}dulled{{/if}}"
                          data-edge-index="{{eindex}}"
                          title="{{edge.type}} Edge — click to toggle dull"
                          role="button"
                          tabindex="0"
                        >
                          <span class="edge-label">{{edge.type}}</span>
                          <a class="edge-remove" aria-label="Remove Edge" title="Remove Edge"><i class="fas fa-times"></i></a>
                        </div>
                      {{/each}}

                      <div class="edge-add-control">
                        <select class="edge-type-select" aria-label="Edge type">
                          <option value="skill">Skill (Failure)</option>
                          <option value="grit">Grit (Harm)</option>
                          <option value="finesse">Finesse (Friction)</option>
                          <option value="vigilance">Vigilance (Loss)</option>
                          <option value="heart">Heart (Fatigue)</option>
                          <option value="providence">Providence (Threat)</option>
                        </select>
                        <a class="edge-add" aria-label="Add Edge" title="Add Edge"><i class="fas fa-plus"></i></a>
                      </div>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <div class="wounds-container">
            <section class="hurt-container">
              <h3 data-value="{{system.hurt}}" data-label="Hurt">Hurt</h3>
              <div class="hurt resource">
                <h3><input type="text" name="system.hurt.value" value="{{system.hurt.value}}" data-dtype="Number"></h3>
                <span>/</span>
                <h3><input type="text" name="system.hurt.max" value="{{system.hurt.max}}" data-dtype="Number"></h3>
              </div>
            </section>
           <section class="wounds">
            <header class="wounds-header">
              <h3>Wounds</h3>
              <a type="button" class="add-wound" aria-label="Add wound"><i class="fas fa-plus"></i></a>
            </header>

            <div class="wounds-list">
              {{#each system.wounds}}
                <div class="wound" data-index="{{@index}}">
                  <input
                    type="text"
                    name="system.wounds.{{@index}}.name"
                    value="{{this.name}}"
                    placeholder="Wound Name"
                    aria-label="Wound name {{@index}}"
                  />

                  <div class="wound-tracker" role="group" aria-label="Wound tracker">
                    {{#each this.boxes}}
                      <div
                        class="box {{#if filled}}filled{{/if}} {{#if skull}}skull{{/if}}"
                        data-value="{{n}}"
                        title="{{#if skull}}Fatal{{else}}Box {{n}}{{/if}}"
                        role="button"
                        tabindex="0"
                      >
                        {{#if skull}}<i class="fa-solid fa-skull" aria-hidden="true"></i>{{/if}}
                      </div>
                      {{#if hasThreshold}}
                        <input
                          class="wound-threshold"
                          type="text"
                          data-threshold-index="{{thresholdIndex}}"
                          value="{{threshold}}"
                          placeholder=""
                          aria-label="Damage threshold after box {{n}}"
                        />
                      {{/if}}
                    {{/each}}
                  </div>

                  <a class="remove-wound" aria-label="Remove wound"><i class="fas fa-trash"></i></a>
                </div>
              {{/each}}
            </div>
          </section>

        </div>
      </div>
    </div>      
    <div class="tab threads" data-group="primary" data-tab="threads">
          <h3>Threads</h3>

          <div class="threads-container">
              <div class="thread-notes">
                {{editor 
                enrichedcharacterNotes
                engine='prosemirror'
                target="system.notes.characterNotes" button=true owner=owner editable=editable
                }}
              </div>
              <div class="thread-notes">
              {{editor 
              enrichedextraNotes
              engine='prosemirror'
              target="system.notes.extraNotes" button=true owner=owner editable=editable
              }}
            </div>
          </div>

    </div>

    <div class="tab items" data-group="primary" data-tab="items">

      <div class="inventory-columns">
        <div class="catalogues-container">
          <header class="catalogues-header">
            <h3>Catalogues</h3>
            <a class="catalogue-create" aria-label="Add Catalogue" title="Add Catalogue"><i class="fas fa-plus"></i></a>
          </header>

          <div class="catalogues-list">
            {{#each catalogues as |catalogue index|}}
              <div class="catalogue-entry" data-index="{{index}}">
                <div class="catalogue-row">
                  <input
                    type="text"
                    class="catalogue-name"
                    value="{{catalogue.name}}"
                    placeholder="Catalogue Name"
                    aria-label="Catalogue name {{index}}"
                  />
                  <div class="catalogue-box-controls">
                    <a class="catalogue-box-remove" aria-label="Remove Checkbox" title="Remove Checkbox"><i class="fas fa-minus"></i></a>
                    <span class="catalogue-box-count">{{catalogue.boxes.length}}</span>
                    <a class="catalogue-box-add" aria-label="Add Checkbox" title="Add Checkbox"><i class="fas fa-plus"></i></a>
                  </div>
                  <a class="catalogue-delete" aria-label="Remove Catalogue" title="Remove Catalogue"><i class="fas fa-trash"></i></a>
                </div>

                <div class="catalogue-boxes">
                  {{#each catalogue.boxes as |box bindex|}}
                    <input
                      type="checkbox"
                      class="catalogue-box"
                      data-box-index="{{bindex}}"
                      {{#if box.checked}}checked{{/if}}
                      aria-label="Checkbox {{bindex}} for {{catalogue.name}}"
                    />
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </div>
        </div>

        <div class="stuff-container">
          <h3>Stuff</h3>
          <textarea class="stuff-notes" placeholder="What you've got on you...">{{stuffNotes}}</textarea>
        </div>
      </div>

    </div>

      {{!-- Assets Tab --}}
    
    <div class="tab assets" data-group="primary" data-tab="assets">
        <h2>Assets</h2>
        <div class="augments-body">
        <div>
            <ol class="items-list">
              <li class="item flexrow item-header">
                <div class="item-image"></div>
                <div class="item-name">Name</div>
                <a class="item-control item-create" title="Create Asset" data-type="asset"><i class="fas fa-plus"></i>Add Asset</a>
              </li>
          {{#each assets as |asset id|}}
          <ol class="items-list"></ol>
            <li class="item flexrow items-list-item" data-item-id="{{asset._id}}">
                <div class="item-image" ><img src="{{asset.img}}" title="{{asset.name}}" width="24" height="24"/></div>
                <h4 class="item-name collapsible"><a class="item-name">{{asset.name}}</a> [{{system.rating}}]</h4>
                <div class="item-controls">
                    <a class="item-control item-edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            <div class="item-description">
              {{{system.description}}}
            </div>
          {{/each}}
          </ol>
        </div>
        </div>
    </div>
      {{!-- Owned Features Tab --}}
      <div class="tab features" data-group="primary" data-tab="features">
          <ol class="items-list">
              <li class="item flexrow item-header">
                <div class="item-image"></div>
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control item-create" title="Create item" data-type="feature"><i class="fas fa-plus"></i> Add item</a>
                </div>
              </li>
          {{#each features as |feature id|}}
              <li class="item flexrow" data-item-id="{{feature._id}}">
                  <div class="item-image"><img src="{{feature.img}}" title="{{feature.name}}" width="24" height="24"/></div>
                  <h4><a class="item-name collapsible">{{feature.name}}</a></h4>
                  <div class="item-controls">
                      <a class="item-control item-edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                      <a class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
                  </div>
              </li>
              <div class="item-description">
                {{{system.description}}}
              </div>
          {{/each}}
          </ol>
      </div>

      <script>
        var coll = Array.from(document.getElementsByClassName("collapsible"));
        var content = Array.from(document.getElementsByClassName("item-description"));
